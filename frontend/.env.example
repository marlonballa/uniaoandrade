# Neon connection string. Keep real credentials in .env.local or the hosting provider.
DATABASE_URL=

# Use a long, unique password (at least 24 characters) for the admin page.
OPEN_ANDRADE_ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie (at least 32 characters).
OPEN_ANDRADE_SESSION_SECRET=

# Instagram API with Instagram Login (Business Login for Instagram) — posts
# de maior engajamento (atualiza a cada 15 dias via cache do Next.js, sem
# cron). Requer conta Instagram Business/Creator e um app em
# developers.facebook.com — não precisa de Página do Facebook. Veja o
# README para o passo a passo completo.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
